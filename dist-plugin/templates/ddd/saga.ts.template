/**
 * {{SagaName}} Saga / Process Manager
 * {{Description}}
 */

export type {{SagaName}}State = {{#each States}}"{{this}}"{{/each}};

export interface CompensationStep {
  readonly action: string;
  readonly description: string;
  readonly execute: () => Promise<void>;
}

export class {{SagaName}} {
  private state: {{SagaName}}State = "{{InitialState}}";
  private readonly compensationSteps: CompensationStep[] = [];

  async handle(event: { type: string; payload: Record<string, unknown> }): Promise<void> {
    switch (event.type) {
      {{#each EventHandlers}}
      case "{{this.eventType}}":
        await this.handle{{this.handlerName}}(event.payload);
        break;
      {{/each}}
      default:
        break;
    }
  }

  {{#each EventHandlers}}
  private async handle{{this.handlerName}}(payload: Record<string, unknown>): Promise<void> {
    // Transition: {{this.transition}}
    // Action: {{this.action}}
    this.state = "{{this.nextState}}";
  }
  {{/each}}

  async compensate(): Promise<void> {
    for (const step of this.compensationSteps.reverse()) {
      await step.execute();
    }
    this.state = "{{CompensatedState}}";
  }

  getState(): {{SagaName}}State {
    return this.state;
  }
}
