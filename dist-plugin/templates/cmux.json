{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,
  "_minimum_cmux_version": {
    "_comment": "Advisory developer metadata. cmux ignores unknown/underscore-prefixed keys at runtime (config doctor validates JSONC syntax, not strict additionalProperties); these track the cmux feature floor each block depends on. Authoritative schema: the $schema URL above.",
    "workspace_layouts": "0.63.0",
    "agent_resume_approvals": "0.64.10"
  },
  "agent_resume_approvals": [
    "claude --resume",
    "claude --continue",
    "claude --session-id"
  ],
  "commands": [
    {
      "name": "Forge Workflow",
      "description": "Full Forge lifecycle: Claude Code + status tail + progress tail + mirror daemon.",
      "keywords": ["forge", "workflow", "build", "review", "ship"],
      "restart": "confirm",
      "workspace": {
        "name": "Forge Workflow",
        "cwd": ".",
        "color": "#3b82f6",
        "layout": {
          "direction": "horizontal",
          "split": 0.5,
          "children": [
            {
              "pane": {
                "surfaces": [
                  { "type": "terminal", "name": "Claude Code", "command": "claude", "focus": true }
                ]
              }
            },
            {
              "direction": "vertical",
              "split": 0.45,
              "children": [
                {
                  "pane": {
                    "surfaces": [
                      { "type": "terminal", "name": "status", "command": "tail -n 50 -f .forge/status.md" }
                    ]
                  }
                },
                {
                  "direction": "vertical",
                  "split": 0.6,
                  "children": [
                    {
                      "pane": {
                        "surfaces": [
                          { "type": "terminal", "name": "progress", "command": "tail -c 20000 -f .forge/progress/*.md 2>/dev/null" }
                        ]
                      }
                    },
                    {
                      "pane": {
                        "surfaces": [
                          { "type": "terminal", "name": "mirror", "command": "node scripts/cmux-mirror/mirror.mjs" }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "Forge Loop Monitor",
      "description": "Forge Loop observability: loop session + sessions tail + git log + mirror daemon.",
      "keywords": ["forge", "loop", "monitor", "unattended"],
      "restart": "confirm",
      "workspace": {
        "name": "Forge Loop Monitor",
        "cwd": ".",
        "color": "#8b5cf6",
        "layout": {
          "direction": "horizontal",
          "split": 0.4,
          "children": [
            {
              "pane": {
                "surfaces": [
                  { "type": "terminal", "name": "forge-loop", "command": "forge-loop", "focus": true }
                ]
              }
            },
            {
              "direction": "vertical",
              "split": 0.4,
              "children": [
                {
                  "pane": {
                    "surfaces": [
                      { "type": "terminal", "name": "sessions", "command": "tail -f .forge/knowledge/sessions/*.md 2>/dev/null" }
                    ]
                  }
                },
                {
                  "direction": "vertical",
                  "split": 0.6,
                  "children": [
                    {
                      "pane": {
                        "surfaces": [
                          { "type": "terminal", "name": "git log", "command": "watch -n 2 'git log --oneline -10 2>/dev/null'" }
                        ]
                      }
                    },
                    {
                      "pane": {
                        "surfaces": [
                          { "type": "terminal", "name": "mirror", "command": "node scripts/cmux-mirror/mirror.mjs" }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    },
    {
      "name": "Forge Dev",
      "description": "Lightweight: Claude Code + test watch + typecheck watch + mirror daemon.",
      "keywords": ["forge", "dev", "watch"],
      "restart": "ignore",
      "workspace": {
        "name": "Forge Dev",
        "cwd": ".",
        "color": "#22c55e",
        "layout": {
          "direction": "horizontal",
          "split": 0.5,
          "children": [
            {
              "pane": {
                "surfaces": [
                  { "type": "terminal", "name": "Claude Code", "command": "claude", "focus": true }
                ]
              }
            },
            {
              "direction": "vertical",
              "split": 0.4,
              "children": [
                {
                  "pane": {
                    "surfaces": [
                      { "type": "terminal", "name": "test", "command": "npm test -- --watch" }
                    ]
                  }
                },
                {
                  "direction": "vertical",
                  "split": 0.6,
                  "children": [
                    {
                      "pane": {
                        "surfaces": [
                          { "type": "terminal", "name": "typecheck", "command": "npm run typecheck -- --watch" }
                        ]
                      }
                    },
                    {
                      "pane": {
                        "surfaces": [
                          { "type": "terminal", "name": "mirror", "command": "node scripts/cmux-mirror/mirror.mjs" }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
