<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forge Review Canvas — {{topic}}</title>
  <style>
    /* Derived from Cursor pr-review-canvas template — see references/canvas.md */
    :root { --bg: #1a1a2e; --card: #16213e; --border: #0f3460; --text: #e4e4e7; --accent: #533483; --ok: #22c55e; --warn: #eab308; --err: #ef4444; }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: var(--bg); color: var(--text); padding: 24px; }
    h1 { font-size: 1.5rem; margin-bottom: 16px; }
    .columns { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }
    .column { background: var(--card); border: 1px solid var(--border); border-radius: 8px; padding: 16px; }
    .column h2 { font-size: 1.1rem; margin-bottom: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }
    .finding { padding: 8px; margin-bottom: 8px; border-radius: 4px; font-size: 0.85rem; }
    .finding.p0, .finding.p1 { border-left: 3px solid var(--err); }
    .finding.p2 { border-left: 3px solid var(--warn); }
    .finding.p3 { border-left: 3px solid var(--accent); }
    .finding .meta { font-size: 0.75rem; opacity: 0.7; margin-top: 4px; }
    .no-findings { text-align: center; opacity: 0.5; padding: 24px; }
    .footer { margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border); font-size: 0.8rem; opacity: 0.6; text-align: center; }
    .pseudo-card { background: rgba(255,255,255,0.03); border: 1px dashed var(--border); padding: 12px; border-radius: 4px; margin-bottom: 8px; cursor: pointer; }
    .pseudo-card .full-diff { display: none; white-space: pre; font-family: monospace; font-size: 0.75rem; max-height: 300px; overflow: auto; }
    .pseudo-card.expanded .full-diff { display: block; }
    .pseudo-card .summary { font-size: 0.85rem; }
  </style>
</head>
<body>
  <h1>Forge Review — {{topic}}</h1>
  <div class="columns">
    <section class="column" id="spec-check">
      <h2>Layer 1 — Spec Alignment</h2>
      <div id="spec-findings"></div>
    </section>
    <section class="column" id="quality-check">
      <h2>Layer 2 — Code Quality</h2>
      <div id="quality-findings"></div>
    </section>
    <section class="column" id="security-check">
      <h2>Layer 3 — Security & Risk</h2>
      <div id="security-findings"></div>
    </section>
  </div>
  <div class="footer">
    Generated by Forge Review Canvas — <span id="timestamp"></span>
    <div id="footer-notice"></div>
  </div>
  <script id="findings-data" type="application/json">{{json_island}}</script>
  <script>{{renderer_js}}</script>
</body>
</html>
