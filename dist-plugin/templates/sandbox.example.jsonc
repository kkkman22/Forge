{
  // Phase 1: Declarative Sandbox Configuration
  // Location: .forge/sandbox.json
  //
  // This file declares filesystem, network, and command access permissions
  // for the Forge development environment. Phase 1 is advisory only:
  // violations produce warnings but do not block operations.
  //
  // Matching rules:
  //   - deny lists take priority over allow lists
  //   - glob patterns use minimatch syntax (**, *, ?)
  //   - unmatched paths/commands default to allowed
  //   - network.deny: ["*"] blocks all network access

  "version": 1,
  "profile": "default",

  "filesystem": {
    // Glob patterns for read access (e.g., "src/**", ".forge/**", "package.json")
    "read": ["**"],

    // Glob patterns for write access (e.g., "src/**", ".forge/progress/**")
    "write": ["**"],

    // Glob patterns that are ALWAYS denied, regardless of allow lists
    // Examples: [".env", "**/*.key", "**/*.pem", "node_modules/**"]
    "deny": []
  },

  "network": {
    // Domain patterns allowed for network access
    // "*" allows all, specific domains for restricted access
    "allow": ["*"],

    // Domain patterns denied for network access
    // ["*"] denies all network access (highest priority over allow)
    "deny": []
  },

  "commands": {
    // Command prefixes that are allowed
    // "*" allows all, or list specific: ["git", "node", "npm", "npx"]
    "allow": ["*"],

    // Command prefixes that are ALWAYS denied
    // Examples: ["rm -rf /", "sudo", "curl"]
    "deny": []
  }
}
