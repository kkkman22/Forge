{
  "version": 1,
  "_minimum_cmux_version": {
    "_comment": "cmux ignores underscore-prefixed fields. These are for developer reference only.",
    "commands": "0.64.3",
    "agent_resume_approvals": "0.64.10"
  },
  "commands": [
    { "label": "/forge build", "action": "forge.build", "description": "Standard tier build" },
    { "label": "/forge review", "action": "forge.review", "description": "Three-layer review" },
    { "label": "/forge ship", "action": "forge.ship", "description": "Push + PR + verify" }
  ],
  "agent_resume_approvals": [
    "claude --resume",
    "claude --continue",
    "claude --session-id"
  ],
  "layouts": {
    "workflow": {
      "name": "Workflow",
      "description": "Full Forge lifecycle: sidebar + main Claude Code session + progress view",
      "panes": [
        {
          "type": "Mirror_Pane",
          "size": "15%",
          "source": "forge-mirror"
        },
        {
          "type": "terminal",
          "size": "70%",
          "action": "forge.newClaudeCode",
          "buttons": [
            { "label": "/forge build", "action": "forge.build" },
            { "label": "/forge review", "action": "forge.review" },
            { "label": "/forge ship", "action": "forge.ship" },
            { "label": "/forge status", "action": "forge.status" }
          ]
        },
        {
          "type": "Progress_Pane",
          "size": "15%"
        }
      ]
    },
    "loop-monitor": {
      "name": "Loop Monitor",
      "description": "Forge Loop observability: sidebar + loop state + main session",
      "panes": [
        {
          "type": "Mirror_Pane",
          "size": "15%",
          "source": "forge-mirror"
        },
        {
          "type": "Loop_State",
          "size": "25%",
          "source": "forge-events"
        },
        {
          "type": "terminal",
          "size": "60%",
          "action": "forge.newClaudeCode",
          "buttons": [
            { "label": "/forge loop", "action": "forge.loop" },
            { "label": "/forge status", "action": "forge.status" },
            { "label": "/forge abort", "action": "forge.abort" }
          ]
        }
      ]
    },
    "dev": {
      "name": "Dev",
      "description": "Lightweight: sidebar + single Claude Code session",
      "panes": [
        {
          "type": "Mirror_Pane",
          "size": "15%",
          "source": "forge-mirror"
        },
        {
          "type": "terminal",
          "size": "85%",
          "action": "forge.newClaudeCode",
          "buttons": [
            { "label": "/forge build", "action": "forge.build" },
            { "label": "/forge test", "action": "forge.test" }
          ]
        }
      ]
    }
  }
}
