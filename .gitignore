node_modules/
# Compiled TypeScript output — regenerated on-demand by CI and local tsc.
# build-dist.sh copies the needed subset into dist/claude-code/bundles/.
dist/src/
dist/scripts/
dist/locales/
dist/test/
dist/workflows/
dist/claude-code/bundles/

# Exception: ship the bundled forge-context MCP server as a single self-contained
# file so marketplace install (root .mcp.json → dist/forge-context.mjs) works
# with zero compilation and zero node_modules. Rebuilt by scripts/bundle-mcp.mjs.
!dist/forge-context.mjs

# dist-plugin is rebuilt on demand by build-dist.sh; not a source of truth
# (marketplace reads repo root via source: "./", not dist-plugin).
dist-plugin/

.DS_Store
*.tsbuildinfo
coverage/
reports/mutation/
.kiro/
!.kiro/specs/INDEX.md
.claude/
# Note: specific files under .claude/ (e.g. .claude/agents/forge-*.md and
# .claude/settings.local.json.example) are force-added with `git add -f`.
# They stay tracked despite the blanket .claude/ ignore above.
.forge/debug/
.forge/archive/
.codex/

# Forge frontend-check login state cache
.forge/cache/

# Forge Stop hook dedupe markers
.forge/.stop-hook-dedupe/

# Forge PR-slug resume cache
.forge/.pr-slug-cache.json

# Compaction snapshot (transient runtime artifact)
.forge/.compact-snapshot.md

# Regenerative checkpoint (runtime state — §11 EXACT-FORM may hold tokens/DSNs)
.forge/checkpoint.md

# dist manifest is tracked (used by CI to verify dist sync)
!dist/claude-code/bundles/.manifest.sha256

# Generated API documentation
docs/api/

apps/forge-loop-desktop/src-tauri/resources/node/bin/nodedist/
.forge/specs/

# Acceptance evidence (screenshots/snapshots may contain secrets) — R4-AC3
.forge/acceptance/

# Local git worktrees (project-local isolation — using-git-worktrees skill)
.worktrees/
.forge/runs/
.forge/findings/
.forge/triage-inbox.md
.forge/state/

# Review diff-context (audit P3): generated by scripts/prepare-diff-context.mjs,
# contains the raw diff under review — if that diff ever captures a real secret
# it would be committed. Generated per-run, no historical value.
.forge/reviews/.diff-context.md

# Usage metrics recorded by the UserPromptSubmit hook (per-user usage data;
# aggregate locally via scripts/aggregate-metrics.mjs). See spec
# metrics-hook-wiring.
.forge/.metrics/

# Tool-health runtime event log (append-only; the tracked .md holds only the
# stable summary + skip-trace counters). See chore/split-tool-health-log-from-md.
.forge/knowledge/tool-health.log

# CI benchmark output (regenerated each run by sync-derived-data.yml and
# consumed by scripts/append-baseline.mjs; not a source artifact).
bench-result.json

# Vitest default output dir (runtime artifact; ship-gates reads .forge/test-results/).
test-results/

# Claude Code run-continuation session cache (local runtime state).
.omo/
