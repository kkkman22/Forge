{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-}/scripts/auto-resume.sh\" 2>/dev/null || bash ~/.claude/skills/tinkerman/scripts/auto-resume.sh 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/inject-evolved-rules.mjs\" 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/inject-evolved-rules.mjs 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/bootstrap-check.mjs\" 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/bootstrap-check.mjs 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/tinkerman-sync-runtime.mjs\" --repair 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/tinkerman-sync-runtime.mjs --repair 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/check-companions.mjs\" 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/check-companions.mjs 2>/dev/null || true",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/cmux-mirror/sync-once.mjs\" .forge 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/cmux-mirror/sync-once.mjs .forge 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "if": "Write(.forge/**)|Edit(.forge/**)",
        "hooks": [
          {
            "type": "command",
            "command": "head -30 .forge/plans/*.md 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "if": "Write(.forge/**)|Edit(.forge/**)|MultiEdit(.forge/**)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-}/scripts/hook-check-frozen.sh\" \"$TOOL_INPUT_FILE\" 2>/dev/null || bash ~/.claude/skills/tinkerman/scripts/hook-check-frozen.sh \"$TOOL_INPUT_FILE\" 2>/dev/null",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "echo \"$TOOL_INPUT\" | grep -oE '\\.forge/(specs|plans)/[a-zA-Z0-9_.-]+|\\.forge/config\\.md' | sort -u | while read -r f; do bash \"${CLAUDE_PLUGIN_ROOT:-}/scripts/hook-check-frozen.sh\" \"$f\" 2>/dev/null || bash ~/.claude/skills/tinkerman/scripts/hook-check-frozen.sh \"$f\" 2>/dev/null; done",
            "timeout": 5
          }
        ]
      },
      {
        "_deprecated": "Replaced by SDK native sandbox (src/frozen-zone-hook.ts). Retained for backward compatibility.",
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/dist/src/check-sandbox.js\" Write \"$TOOL_INPUT_FILE\" 2>/dev/null || node forge/dist/src/check-sandbox.js Write \"$TOOL_INPUT_FILE\" 2>/dev/null || node ~/.claude/skills/tinkerman/dist/src/check-sandbox.js Write \"$TOOL_INPUT_FILE\" 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "_deprecated": "Replaced by SDK native sandbox (src/sandbox-profile.ts). Retained for backward compatibility.",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .forge/.sandbox-active.json ]; then node \"${CLAUDE_PLUGIN_ROOT:-}/dist/src/check-sandbox.js\" Bash \"$TOOL_INPUT_FILE\" 2>/dev/null || node forge/dist/src/check-sandbox.js Bash \"$TOOL_INPUT_FILE\" 2>/dev/null || node ~/.claude/skills/tinkerman/dist/src/check-sandbox.js Bash \"$TOOL_INPUT_FILE\" 2>/dev/null || true; fi",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/check-context-boundary.mjs\" 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/check-context-boundary.mjs 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/bash-ban-raw.mjs\" 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/bash-ban-raw.mjs 2>/dev/null || true",
            "timeout": 2
          }
        ]
      },
      {
        "_audit_p1": "Unconditional destructive guard (audit P1). check-sandbox only fires when .forge/.sandbox-active.json exists — so in normal runs git reset --hard / push --force / clean -fd had no interceptor. This hook calls the same checkDestructive authority with guardEnabled=true always.",
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/check-destructive.mjs\" 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/check-destructive.mjs 2>/dev/null || true",
            "timeout": 2
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-}/scripts/hook-check-frozen-post.sh\" 2>/dev/null || bash ~/.claude/skills/tinkerman/scripts/hook-check-frozen-post.sh 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "if": "Write(.forge/**)|Edit(.forge/**)",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -d .forge/status ] || [ -f .forge/status.md ]; then echo '📝 代码已修改。请记得更新 .forge/progress/ 中的任务状态。'; fi"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "if": "Write(.forge/**)|Edit(.forge/**)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/cmux-mirror/sync-once.mjs\" .forge 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/cmux-mirror/sync-once.mjs .forge 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "if": "Write(.forge/**)|Edit(.forge/**)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/rebuild-feature-dossier.mjs\" 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/rebuild-feature-dossier.mjs 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "if": "Write(.forge/**)|Edit(.forge/**)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/knowledge-hook-dispatch.mjs\" 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/knowledge-hook-dispatch.mjs 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/check-context-boundary.mjs\" PostToolUse \"$TOOL_INPUT_FILE\" 2>/dev/null || true",
            "continueOnBlock": true,
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "if": "Write(.forge/reviews/.diff-context.md)|Edit(.forge/reviews/.diff-context.md)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/check-diff-context-integrity.mjs\" 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/check-diff-context-integrity.mjs 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/stop-pending-rules.mjs\" 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/stop-pending-rules.mjs 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/flag-stale-evolved-rules.mjs\" 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/flag-stale-evolved-rules.mjs 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/cmux-mirror/sync-once.mjs\" .forge 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/cmux-mirror/sync-once.mjs .forge 2>/dev/null || true",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/stop-phase-verify.mjs\" 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/stop-phase-verify.mjs 2>/dev/null || true",
            "timeout": 3
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -d .forge/status ]; then status_file=$(ls -t .forge/status/*.md 2>/dev/null | head -1); else status_file='.forge/status.md'; fi; phase=$(grep '^phase:' \"$status_file\" 2>/dev/null | sed 's/phase: *\"\\{0,1\\}//;s/\"\\{0,1\\} *$//'); if [ \"$phase\" = 'review' ] || [ \"$phase\" = 'decide' ]; then echo '队友空闲。请检查是否所有评审/决策维度都已完成输出，未完成的队友应继续工作。'; fi"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-}/scripts/hook-precompact.sh\" 2>/dev/null || bash ~/.claude/skills/tinkerman/scripts/hook-precompact.sh 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT:-}/scripts/hook-postcompact.sh\" 2>/dev/null || bash ~/.claude/skills/tinkerman/scripts/hook-postcompact.sh 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .forge/status.md ]; then phase=$(grep '^phase:' .forge/status.md 2>/dev/null | sed 's/phase: *\"\\{0,1\\}//;s/\"\\{0,1\\} *$//'); if [ \"$phase\" = 'build' ]; then plan_file=$(ls -t .forge/plans/*.md 2>/dev/null | head -1); if [ -n \"$plan_file\" ]; then plan_status=$(grep '^status:' \"$plan_file\" 2>/dev/null | head -1 | sed 's/status: *\"\\{0,1\\}//;s/\"\\{0,1\\} *$//' | tr -d '[:space:]'); if [ \"$plan_status\" != 'approved' ]; then echo \"⚠️ build 阶段：plan 状态为 $plan_status（非 approved），队友任务建议等 plan 锁定后再创建\" >&2; fi; fi; fi; fi"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT:-}/scripts/config-changed-hook.mjs\" 2>/dev/null || node ~/.claude/skills/tinkerman/scripts/config-changed-hook.mjs 2>/dev/null || true",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60",
    "MCP_CONNECTION_NONBLOCKING": "true",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "true"
  }
}
