{
  "name": "forge",
  "description": "Unified AI coding workflow framework — single /forge slash command with 22 internal subcommands, TDD, spec-driven planning, and automated review.",
  "version": "2.7.0",
  "workflows": ["./workflows"],
  "mcpServers": {
    "forge-context": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/src/mcp/server.js"
      ]
    }
  },
  "author": {
    "name": "Forge contributors",
    "url": "https://github.com/kkkman22/Forge"
  },
  "license": "MIT",
  "homepage": "https://github.com/kkkman22/Forge",
  "keywords": [
    "workflow",
    "tdd",
    "spec-driven",
    "code-review",
    "ci"
  ],
  "userConfig": {
    "max_parallel_agents": {
      "type": "number",
      "default": 6,
      "description": "Max concurrent subagents (1-10, default 6)"
    },
    "safety_level": {
      "type": "string",
      "enum": ["1", "2", "3"],
      "default": "1",
      "description": "Safety strictness (1=strictest)"
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PLUGIN_ROOT}/scripts/auto-resume.sh"],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/inject-evolved-rules.mjs"],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap-check.mjs"],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/inject-plan-context.mjs"],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/cmux-mirror/sync-once.mjs", ".forge"],
            "timeout": 2
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/message-display-hook.mjs"],
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "args": ["head", "-30", ".forge/plans/*.md"],
            "if": "exists(.forge/plans/*.md)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PLUGIN_ROOT}/scripts/hook-check-frozen.sh"],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PLUGIN_ROOT}/scripts/hook-check-frozen.sh"],
            "if": "Bash(git commit*)",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/dist/src/check-sandbox.js", "Write"],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/dist/src/check-sandbox.js", "Bash"],
            "if": "exists(.forge/.sandbox-active.json)",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/check-context-boundary.mjs"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/postooluse-inject-warnings.mjs"],
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "if": "exists(.forge/status.md)",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -d .forge/status ] || [ -f .forge/status.md ]; then echo '📝 代码已修改。请记得更新 .forge/progress/ 中的任务状态。'; fi"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/cmux-mirror/sync-once.mjs", ".forge"],
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/rebuild-feature-dossier.mjs", "--from-path"],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/check-context-boundary.mjs", "PostToolUse"],
            "continueOnBlock": true,
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/check-diff-context-integrity.mjs"],
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PLUGIN_ROOT}/scripts/hook-precompact.sh"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PLUGIN_ROOT}/scripts/hook-postcompact.sh"],
            "timeout": 5
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/cwd-changed-hook.mjs"],
            "timeout": 3
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/file-changed-hook.mjs"],
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .forge/progress/*.md ] 2>/dev/null; then incomplete=$(grep -c '\\- \\[ \\]' .forge/progress/*.md 2>/dev/null || echo 0); if [ \"$incomplete\" -gt 0 ]; then echo '⚠️ 仍有未完成的任务。下次会话可使用 /forge resume 恢复上下文。'; else echo '✅ 任务已完成。建议运行 /forge learn 沉淀本次开发经验。'; fi; fi"
          },
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PLUGIN_ROOT}/scripts/persistent-loop.sh"],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .forge/knowledge/evolved-rules.md ] && grep -q 'PENDING' .forge/knowledge/evolved-rules.md 2>/dev/null; then count=$(grep -c 'PENDING' .forge/knowledge/evolved-rules.md 2>/dev/null || echo 0); echo \"⚠️ 有 $count 条待审核的规则提案。运行 /forge learn 查看并审批。\"; fi",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/record-evolved-rule-violation.mjs"],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/flag-stale-evolved-rules.mjs"],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/cmux-mirror/sync-once.mjs", ".forge"],
            "timeout": 2
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .forge/status.md ]; then phase=$(grep '^phase:' .forge/status.md 2>/dev/null | sed 's/phase: *\"\\{0,1\\}//;s/\"\\{0,1\\} *$//'); if [ -n \"$phase\" ] && [ \"$phase\" != 'completed' ] && [ \"$phase\" != '' ]; then echo \"⚠️ Phase: $phase — did you verify your last change? Run the relevant test/lint command before stopping.\"; fi; fi",
            "timeout": 3
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -d .forge/status ]; then status_file=$(ls -t .forge/status/*.md 2>/dev/null | head -1); else status_file='.forge/status.md'; fi; phase=$(grep '^phase:' \"$status_file\" 2>/dev/null | sed 's/phase: *\"\\{0,1\\}//;s/\"\\{0,1\\} *$//'); if [ \"$phase\" = 'review' ] || [ \"$phase\" = 'decide' ]; then echo '队友空闲。请检查是否所有评审/决策维度都已完成输出，未完成的队友应继续工作。'; fi"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '✅ 团队任务已完成。负责人请汇总队友输出并检查是否需要合并发现。'"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/config-changed-hook.mjs"],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
