{
  "name": "forge",
  "description": "Unified AI coding workflow framework — single /forge slash command with 22 internal subcommands, TDD, spec-driven planning, and automated review.",
  "version": "2.7.0",
  "workflows": ["./workflows"],
  "mcpServers": {
    "forge-context": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/src/mcp/server.js"
      ],
      "alwaysLoad": true
    }
  },
  "author": {
    "name": "Forge contributors",
    "url": "https://github.com/kkkman22/Forge"
  },
  "license": "MIT",
  "homepage": "https://github.com/kkkman22/Forge",
  "keywords": [
    "workflow",
    "tdd",
    "spec-driven",
    "code-review",
    "ci"
  ],
  "userConfig": {
    "max_parallel_agents": {
      "type": "number",
      "default": 6,
      "description": "Max concurrent subagents (1-10, default 6)"
    },
    "safety_level": {
      "type": "string",
      "enum": ["1", "2", "3"],
      "default": "1",
      "description": "Safety strictness (1=strictest)"
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PLUGIN_ROOT}/scripts/auto-resume.sh"],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/inject-evolved-rules.mjs"],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/bootstrap-check.mjs"],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/inject-plan-context.mjs"],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/cmux-mirror/sync-once.mjs", ".forge"],
            "timeout": 2
          }
        ]
      }
    ],
    "MessageDisplay": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/message-display-hook.mjs"],
            "timeout": 2
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "args": ["head", "-30", ".forge/plans/*.md"],
            "if": "exists(.forge/plans/*.md)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PLUGIN_ROOT}/scripts/hook-check-frozen.sh"],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PLUGIN_ROOT}/scripts/hook-check-frozen.sh"],
            "if": "Bash(git commit*)",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/dist/src/check-sandbox.js", "Write"],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/dist/src/check-sandbox.js", "Bash"],
            "if": "exists(.forge/.sandbox-active.json)",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/check-context-boundary.mjs"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/postooluse-inject-warnings.mjs"],
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "if": "exists(.forge/status.md)",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/posttooluse-status-reminder.mjs"],
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/cmux-mirror/sync-once.mjs", ".forge"],
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/rebuild-feature-dossier.mjs", "--from-path"],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/check-context-boundary.mjs", "PostToolUse"],
            "continueOnBlock": true,
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/check-diff-context-integrity.mjs"],
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PLUGIN_ROOT}/scripts/hook-precompact.sh"],
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PLUGIN_ROOT}/scripts/hook-postcompact.sh"],
            "timeout": 5
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/cwd-changed-hook.mjs"],
            "timeout": 3
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/file-changed-hook.mjs"],
            "timeout": 3
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/worktree-create-hook.mjs"],
            "timeout": 3
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/worktree-remove-hook.mjs"],
            "timeout": 3
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/task-created-hook.mjs"],
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/stop-incomplete-tasks.mjs"],
            "timeout": 5
          },
          {
            "type": "command",
            "args": ["bash", "${CLAUDE_PLUGIN_ROOT}/scripts/persistent-loop.sh"],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/stop-pending-rules.mjs"],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/record-evolved-rule-violation.mjs"],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/flag-stale-evolved-rules.mjs"],
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/cmux-mirror/sync-once.mjs", ".forge"],
            "timeout": 2
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/stop-phase-verify.mjs"],
            "timeout": 3
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/teammate-idle-phase-check.mjs"],
            "timeout": 3
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/task-completed-notify.mjs"],
            "timeout": 2
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "hooks": [
          {
            "type": "command",
            "args": ["node", "${CLAUDE_PLUGIN_ROOT}/scripts/config-changed-hook.mjs"],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
