{
  "name": "tinkerman",
  "description": "Unified AI coding workflow framework - single /tinkerman slash command with 36 internal subcommands, TDD, spec-driven planning, and automated review.",
  "version": "3.9.0",
  "requiredMinimumVersion": "2.1.163",
  "workflows": [
    "./workflows"
  ],
  "author": {
    "name": "Tinkerman contributors",
    "url": "https://github.com/kkkman22/Forge"
  },
  "license": "MIT",
  "homepage": "https://github.com/kkkman22/Forge",
  "keywords": [
    "brake",
    "review",
    "gates",
    "lifecycle-hooks",
    "verification"
  ],
  "userConfig": {
    "max_parallel_agents": {
      "title": "Max Parallel Agents",
      "type": "number",
      "default": 6,
      "description": "Max concurrent subagents (1-10, default 6)"
    },
    "safety_level": {
      "title": "Safety Level",
      "type": "string",
      "default": "1",
      "description": "Safety strictness (1=strictest, 3=most relaxed)"
    }
  }
}
