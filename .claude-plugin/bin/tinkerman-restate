#!/usr/bin/env bash
# forge-restate — Trigger a restatement checkpoint for the current task.
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat <<'HELP'
forge-restate — Trigger a restatement checkpoint

Usage: forge-restate [--check] [--reset]

Options:
  --help, -h   Show this help message
  --check      Show current restatement status without writing
  --reset      Reset the restatement counter

Writes a restatement checkpoint to .forge/state/last-restatement.json,
recording the current task name, completed task count, and timestamp.
Used by the PreCompact hook to determine if compression should be blocked.

The PreCompact hook blocks compression when more than N tasks have been
completed since the last restatement (configurable in .forge/config.md).
HELP
  exit 0
fi

ROOT="${FORGE_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || echo .)}"
cd "$ROOT"

STATUS_FILE=".forge/status.md"
STATE_DIR=".forge/state"

if [[ ! -f "$STATUS_FILE" ]]; then
  echo "No active Forge task. Nothing to restate."
  exit 0
fi

mkdir -p "$STATE_DIR"

current_task=$(grep '^current_task:' "$STATUS_FILE" | sed 's/current_task: *"\{0,1\}//;s/"\{0,1\} *$//')

if [[ "${1:-}" == "--reset" ]]; then
  rm -f "$STATE_DIR/last-restatement.json"
  echo "Restatement counter reset."
  exit 0
fi

if [[ "${1:-}" == "--check" ]]; then
  if [[ -f "$STATE_DIR/last-restatement.json" ]]; then
    cat "$STATE_DIR/last-restatement.json"
  else
    echo '{"status":"no_checkpoint"}'
  fi
  exit 0
fi

# Count completed tasks in progress file
PROGRESS_FILE=".forge/progress/${current_task}.md"
tasks_count=0
if [[ -f "$PROGRESS_FILE" ]]; then
  tasks_count=$(grep -c '\- \[x\]' "$PROGRESS_FILE" 2>/dev/null || echo 0)
fi

timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

cat > "$STATE_DIR/last-restatement.json" <<EOF
{
  "spec": "$current_task",
  "tasks_completed_count": $tasks_count,
  "timestamp": "$timestamp"
}
EOF

echo "Restatement checkpoint saved: $tasks_count tasks completed at $timestamp"
