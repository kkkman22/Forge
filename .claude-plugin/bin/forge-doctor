#!/usr/bin/env bash
# forge-doctor — Health check for Forge project setup.
# Checks: version compatibility, plugin health, hooks, commands, bin, MCP.
set -euo pipefail

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  cat <<'HELP'
forge-doctor — Forge project health check

Usage: forge-doctor [--fix] [--json]

Options:
  --help, -h   Show this help message
  --fix        Attempt to fix detected issues
  --json       Output results in JSON format

Checks:
  1. Claude Code version compatibility (>= 2.1.163)
  2. .forge/ directory structure
  3. .forge/config.md present and valid
  4. Plugin manifest (.claude-plugin/plugin.json)
  5. Commands entry (commands/forge.md)
  6. Hooks configuration (hooks/hooks.json)
  7. Bin scripts (forge-doctor, forge-status, forge-restate)
  8. MCP server registration
  9. Git branch protection
  10. Plugin enabled check (manual step)
  11. Forge diagnostic mode status

Run 'forge-doctor --json' for structured output with fixHint per item.
HELP
  exit 0
fi

ROOT="${FORGE_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || echo .)}"
cd "$ROOT"

PASS=0; FAIL=0; WARN=0
DIAGNOSTIC_MODE_ACTIVE=false
if [[ "${FORGE_DIAGNOSTIC_MODE:-}" == "1" ]]; then
  DIAGNOSTIC_MODE_ACTIVE=true
fi

# JSON output accumulator
JSON_ITEMS=""

check() {
  local label="$1" status="$2" id="${3:-}" fix_hint="${4:-}"
  case "$status" in
    pass) echo "  ✅ $label"; PASS=$((PASS+1)) ;;
    warn) echo "  ⚠️  $label"; WARN=$((WARN+1)) ;;
    *)    echo "  ❌ $label"; FAIL=$((FAIL+1)) ;;
  esac
  # Accumulate JSON item
  if [[ -n "$id" ]]; then
    local msg=""
    case "$status" in
      pass) msg="$label" ;;
      warn) msg="$label" ;;
      *) msg="$label" ;;
    esac
    local escaped_msg=$(echo "$msg" | sed 's/"/\\"/g')
    local escaped_hint=$(echo "$fix_hint" | sed 's/"/\\"/g')
    if [[ -n "$JSON_ITEMS" ]]; then
      JSON_ITEMS="${JSON_ITEMS},"
    fi
    JSON_ITEMS="${JSON_ITEMS}{\"id\":\"$id\",\"label\":\"$escaped_msg\",\"status\":\"$status\",\"message\":\"$escaped_msg\"${fix_hint:+,\"fixHint\":\"$escaped_hint\"}}"
  fi
  return 0
}

echo "🔍 Forge Doctor — checking project health"
echo ""

# --- 0. Claude Code version compatibility ---
echo "📋 Version Check"
CC_VERSION=""
if command -v claude &>/dev/null; then
  CC_VERSION=$(claude --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || echo "")
fi

if [[ -z "$CC_VERSION" ]]; then
  check "Claude Code version (unavailable — install or check PATH)" warn "version" "Run 'claude --version' to verify installation"
elif [[ "$CC_VERSION" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
  C_MAJOR=${BASH_REMATCH[1]}
  C_MINOR=${BASH_REMATCH[2]}
  C_PATCH=${BASH_REMATCH[3]}
  # Compare with 2.1.163
  if [[ "$C_MAJOR" -lt 2 ]] || { [[ "$C_MAJOR" -eq 2 ]] && { [[ "$C_MINOR" -lt 1 ]] || { [[ "$C_MINOR" -eq 1 ]] && [[ "$C_PATCH" -lt 163 ]]; }; }; }; then
    check "Claude Code $CC_VERSION (below minimum 2.1.163)" fail "version" "Update Claude Code to >= 2.1.163"
  else
    check "Claude Code $CC_VERSION (>= 2.1.163)" pass "version"
  fi
else
  check "Claude Code version (unparseable: $CC_VERSION)" warn "version" "Run 'claude --version' and check output format"
fi
echo ""

# --- 1. .forge/ directory ---
echo "📋 Project Structure"
if [[ -d .forge ]]; then check ".forge/ directory" pass "forge-dir"; else check ".forge/ directory (missing — run forge init)" fail "forge-dir" "Run /forge init to create .forge/ directory"; fi

# --- 2. config.md ---
if [[ -f .forge/config.md ]]; then check ".forge/config.md" pass "config"; else check ".forge/config.md" fail "config" "Run /forge init to generate config"; fi
echo ""

# --- 3. Plugin manifest ---
echo "📋 Plugin Health"
if [[ -f .claude-plugin/plugin.json ]]; then
  if python3 -c "import json; json.load(open('.claude-plugin/plugin.json'))" 2>/dev/null || node -e "JSON.parse(require('fs').readFileSync('.claude-plugin/plugin.json','utf-8'))" 2>/dev/null; then
    # Check version consistency with package.json
    PLUGIN_VER=$(node -e "console.log(JSON.parse(require('fs').readFileSync('.claude-plugin/plugin.json','utf-8')).version)" 2>/dev/null || echo "")
    PKG_VER=$(node -e "console.log(JSON.parse(require('fs').readFileSync('package.json','utf-8')).version)" 2>/dev/null || echo "")
    if [[ -n "$PLUGIN_VER" && -n "$PKG_VER" && "$PLUGIN_VER" == "$PKG_VER" ]]; then
      check "Plugin manifest v${PLUGIN_VER} (matches package.json)" pass "manifest"
    elif [[ -n "$PLUGIN_VER" ]]; then
      check "Plugin manifest v${PLUGIN_VER} (package.json v${PKG_VER:-?} mismatch)" warn "manifest" "Update plugin.json version to match package.json"
    else
      check "Plugin manifest (version not readable)" warn "manifest"
    fi
  else
    check "Plugin manifest (JSON parse error)" fail "manifest" "Fix or regenerate .claude-plugin/plugin.json"
  fi
else
  check "Plugin manifest (missing)" warn "manifest" "Ensure .claude-plugin/plugin.json exists"
fi

# --- 4. Commands ---
if [[ -f commands/forge.md ]]; then
  check "/forge command entry (commands/forge.md)" pass "commands"
else
  check "/forge command entry (missing)" warn "commands" "Ensure commands/forge.md exists for /forge slash command"
fi

# --- 5. Hooks ---
echo ""
echo "📋 Hooks Configuration"
if [[ -f hooks/hooks.json ]]; then
  if node -e "const h=JSON.parse(require('fs').readFileSync('hooks/hooks.json','utf-8')).hooks; ['SessionStart','UserPromptSubmit','PreToolUse','PostToolUse','Stop'].forEach(e=>{if(!h[e])throw new Error('missing '+e)})" 2>/dev/null; then
    check "hooks/hooks.json (all key events present)" pass "hooks"
  else
    MISSING=$(node -e "const h=JSON.parse(require('fs').readFileSync('hooks/hooks.json','utf-8')).hooks; const r=['SessionStart','UserPromptSubmit','PreToolUse','PostToolUse','Stop'].filter(e=>!h[e]); console.log(r.join(', '))" 2>/dev/null || echo "parse error")
    check "hooks/hooks.json (missing events: $MISSING)" warn "hooks" "Add missing hook events to hooks/hooks.json"
  fi
else
  check "hooks/hooks.json (missing)" fail "hooks" "Ensure hooks/hooks.json exists and is valid JSON"
fi

# --- 6. Bin scripts ---
echo ""
echo "📋 Bin Scripts"
for cmd in forge-doctor forge-status forge-restate; do
  if [[ -f ".claude-plugin/bin/$cmd" ]]; then
    if bash ".claude-plugin/bin/$cmd" --help &>/dev/null; then
      check "bin/$cmd (--help OK)" pass "bin-$cmd"
    else
      check "bin/$cmd (--help failed)" warn "bin-$cmd" "Check .claude-plugin/bin/$cmd is executable and --help works"
    fi
  else
    check "bin/$cmd (missing)" warn "bin-$cmd" "Create or restore .claude-plugin/bin/$cmd"
  fi
done

# --- 7. MCP server ---
echo ""
echo "📋 MCP Server"
if [[ -f dist/src/mcp/server.js ]]; then
  check "MCP server (dist/src/mcp/server.js exists)" pass "mcp"
elif [[ -f src/mcp/server.ts ]]; then
  check "MCP server source (src/mcp/server.ts exists, no dist)" warn "mcp" "Run 'bash scripts/build-dist.sh' to compile MCP server"
else
  check "MCP server (not found)" fail "mcp" "Ensure src/mcp/server.ts or dist/src/mcp/server.js exists"
fi

# --- 8. Git branch ---
echo ""
echo "📋 Git"
BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")
if [[ "$BRANCH" == "main" || "$BRANCH" == "master" ]]; then
  check "Git branch ($BRANCH — should be feature/*)" warn "git-branch" "Create a feature branch: git checkout -b feature/<topic>"
else
  check "Git branch ($BRANCH)" pass "git-branch"
fi

# --- 9. Plugin enabled (manual check) ---
echo ""
echo "📋 Plugin Status"
check "Plugin enabled (verify manually: /plugin list --enabled)" warn "plugin-enabled" "In Claude Code, run '/plugin list --enabled' and confirm 'forge' appears"

# --- 10. Forge diagnostic mode ---
echo ""
echo "📋 Diagnostic Mode"
if [[ "$DIAGNOSTIC_MODE_ACTIVE" == "true" ]]; then
  check "FORGE_DIAGNOSTIC_MODE active (optional injections disabled)" warn "diagnostic-mode" "Unset FORGE_DIAGNOSTIC_MODE to restore normal SessionStart injections"
else
  check "FORGE_DIAGNOSTIC_MODE inactive" pass "diagnostic-mode"
fi

# --- Summary ---
echo ""
echo "📊 Summary: $PASS passed, $WARN warnings, $FAIL failures"

if [[ "${1:-}" == "--json" ]]; then
  # Build structured JSON output
  VERSION_JSON="{\"currentVersion\":\"${CC_VERSION:-null}\",\"minimumVersion\":\"2.1.163\",\"maximumVersion\":null,\"verifiedLatest\":\"2.1.163\",\"verdict\":\"$([ -n \"$CC_VERSION\" ] && echo pass || echo unknown)\"}"
  echo "{\"version\":$VERSION_JSON,\"diagnosticMode\":{\"active\":$DIAGNOSTIC_MODE_ACTIVE,\"env\":\"FORGE_DIAGNOSTIC_MODE\"},\"checks\":[$JSON_ITEMS],\"summary\":{\"pass\":$PASS,\"warn\":$WARN,\"fail\":$FAIL}}"
fi

[[ $FAIL -eq 0 ]]
