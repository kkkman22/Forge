{
  "name": "forge",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write src/ test/",
    "format": "biome format --write src/ test/",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && biome check src/ test/ && vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/node": "24.12.2",
    "@vitest/coverage-v8": "3.2.4",
    "fast-check": "4.7.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
