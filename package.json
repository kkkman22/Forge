{
  "name": "forge-loop",
  "version": "2.3.0",
  "private": false,
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src/"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "forge-loop": "dist/src/forge-loop-cli.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write src/ test/",
    "format": "biome format --write src/ test/",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && biome check src/ test/ && vitest run && bash scripts/check-readme-metrics.sh && bash scripts/check-skill-function-refs.sh",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@types/node": "24.12.2",
    "@vitest/coverage-v8": "3.2.4",
    "fast-check": "4.7.0",
    "typedoc": "0.28.19",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.119",
    "@modelcontextprotocol/sdk": "1.29.0",
    "commander": "14.0.3",
    "minimatch": "^10.2.5",
    "zod": "4.4.1"
  }
}
