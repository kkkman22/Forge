{
  "entryPoints": ["src/"],
  "entryPointStrategy": "expand",
  "out": "docs/api",
  "cleanOutputDir": true,
  "tsconfig": "tsconfig.json",
  "name": "Forge Loop",
  "excludeInternal": true,
  "exclude": ["test/**/*.ts", "src/domain/**"],
  "treatWarningsAsErrors": true,
  "validation": {
    "notExported": true,
    "invalidLink": true
  },
  "blockTags": [
    "@param",
    "@returns",
    "@throws",
    "@example",
    "@deprecated",
    "@defaultValue",
    "@typeParam",
    "@remarks",
    "@see",
    "@since",
    "@category",
    "@group",
    "@satisfies",
    "@overload",
    "@template",
    "@type",
    "@typedef",
    "@callback",
    "@prop",
    "@property",
    "@visibleForTesting",
    "@context",
    "@file",
    "@module",
    "@non-production"
  ],
  "ignoredHighlightLanguages": ["gitignore", "markdown"],
  "externalSymbolLinkMappings": {
    "forge-loop": {
      "FailureContext": "#",
      "buildFailureEpisode": "#",
      "buildFailureEvolutionMarker": "#",
      "Episode": "#",
      "Pattern": "#",
      "findUpgradableEpisodes": "#",
      "EvolutionReport": "#",
      "parseEvolutionMarkers": "#",
      "aggregateEvolutionMarkers": "#"
    }
  }
}
