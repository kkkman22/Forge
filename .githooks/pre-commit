#!/bin/sh
# docs-governance pre-commit hook
# Decision tree: detect what changed, run only relevant checkers.
# Lightweight path (no docs/ changes): exit 0 immediately.

set -e

# ── Grace period check ──
GRACE_UNTIL=""
CONFIG_FILE=".forge/config.md"
if [ -f "$CONFIG_FILE" ]; then
  GRACE_UNTIL=$(grep -A1 'grace_period_until' "$CONFIG_FILE" 2>/dev/null | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' | head -1)
fi

TODAY=$(date -u +%Y-%m-%d 2>/dev/null || date +%Y-%m-%d)
IN_GRACE=""
if [ -n "$GRACE_UNTIL" ] && [ "$TODAY" \< "$GRACE_UNTIL" ]; then
  IN_GRACE="1"
fi

# ── Detect changed files ──
STAGED=$(git diff --cached --name-only 2>/dev/null || echo "")

if [ -z "$STAGED" ]; then
  # No staged files — nothing to check
  exit 0
fi

# ── README metrics auto-sync (test/, src/*.ts, or README staged) ──
# check-readme-metrics.sh rewrites drifted counts in-place locally; we then
# re-stage README so the fix lands in THIS commit (origin self-corrects — no
# manual bump, no stale origin). Best-effort and non-blocking here; the pre-push
# `npm run check` remains the hard gate. Adds ~24s (vitest list) ONLY when
# test/src/README is staged, so docs/config commits stay instant.
if echo "$STAGED" | grep -qE '^test/|^src/.*\.ts$|^README\.md$'; then
  METRICS_LOG="/tmp/forge-readme-metrics.$$.log"
  if bash scripts/check-readme-metrics.sh >"$METRICS_LOG" 2>&1; then
    if ! git diff --quiet README.md 2>/dev/null; then
      git add README.md
      echo "📊 readme-metrics: auto-synced README counts, staged for this commit."
    fi
  else
    echo "⚠️  readme-metrics: sync skipped (check error, non-blocking):"
    sed -n '1,8p' "$METRICS_LOG"
  fi
  rm -f "$METRICS_LOG"
fi

# ── Lightweight path: no docs/ changes ──
DOCS_CHANGED=$(echo "$STAGED" | grep -c "^docs/" || true)
CONFIG_CHANGED=$(echo "$STAGED" | grep -c "^\.forge/config\.md$" || true)
ROOT_MD_CHANGED=$(echo "$STAGED" | grep -c "^[A-Z][^.]*\.md$" || true)
SSOT_CHANGED=$(echo "$STAGED" | grep -c "^docs/_ssot/" || true)

if [ "$DOCS_CHANGED" -eq 0 ] && [ "$CONFIG_CHANGED" -eq 0 ] && [ "$ROOT_MD_CHANGED" -eq 0 ] && [ "$SSOT_CHANGED" -eq 0 ]; then
  # Lightweight path — no docs-related changes
  exit 0
fi

echo "📝 docs-governance: checking staged changes..."

FAILED=0

# ── Helper: run checker with grace period support ──
run_checker() {
  label="$1"
  shift
  timeout_s="${CHECKER_TIMEOUT:-30}"

  # macOS compatibility: use gtimeout (coreutils) or plain exec if no timeout available
  if command -v timeout >/dev/null 2>&1; then
    run_cmd="timeout $timeout_s"
  elif command -v gtimeout >/dev/null 2>&1; then
    run_cmd="gtimeout $timeout_s"
  else
    run_cmd=""
  fi

  if [ -n "$IN_GRACE" ]; then
    # Grace period: downgrade errors to warnings
    if [ -n "$run_cmd" ]; then
      output=$($run_cmd "$@" 2>&1) && rc=$? || rc=$?
      if [ "$rc" -eq 124 ]; then
        echo "  ⚠️  $label: timed out after ${timeout_s}s (grace period — not blocking)"
        return 0
      fi
    else
      output=$("$@" 2>&1) && rc=$? || rc=$?
    fi
    if [ "$rc" -ne 0 ]; then
      echo "  ⚠️  $label: issues found (grace period — not blocking)"
      echo "$output" | head -5
    else
      echo "  ✅ $label: clean"
    fi
  else
    if [ -n "$run_cmd" ]; then
      output=$($run_cmd "$@" 2>&1) && rc=$? || rc=$?
      if [ "$rc" -eq 124 ]; then
        echo "  ❌ $label: timed out after ${timeout_s}s"
        FAILED=1
        return 0
      fi
    else
      output=$("$@" 2>&1) && rc=$? || rc=$?
    fi
    if [ "$rc" -ne 0 ]; then
      echo "  ❌ $label: failed"
      echo "$output"
      FAILED=1
    else
      echo "  ✅ $label: clean"
    fi
  fi
}

# ── Decision tree ──

# Root .md files → root whitelist check
if [ "$ROOT_MD_CHANGED" -ne 0 ]; then
  run_checker "Root whitelist" npx tsx scripts/check-docs-root-whitelist.ts
fi

# Docs/ files → frontmatter, bilingual, index, updated checks
if [ "$DOCS_CHANGED" -ne 0 ]; then
  run_checker "Frontmatter" npx tsx scripts/check-docs-frontmatter.ts
  run_checker "Bilingual" npx tsx scripts/check-docs-bilingual.ts
  run_checker "Index sync" npx tsx scripts/check-docs-index.ts
  run_checker "Updated" npx tsx scripts/check-docs-updated.ts
fi

# Docs/ or SSOT → embed sync check
if [ "$DOCS_CHANGED" -ne 0 ] || [ "$SSOT_CHANGED" -ne 0 ]; then
  run_checker "Embed sync" npx tsx scripts/check-docs-embeds.ts
fi

# Config changes → staleness, links, quota
if [ "$CONFIG_CHANGED" -ne 0 ]; then
  run_checker "Staleness" npx tsx scripts/check-docs-staleness.ts
  run_checker "Links" npx tsx scripts/check-docs-links.ts
  run_checker "Quota" npx tsx scripts/check-docs-quota.ts
fi

# ── Result ──

if [ "$FAILED" -ne 0 ]; then
  echo ""
  echo "🚫 docs-governance checks failed."
  echo "   Run \`npm run docs:build\` to regenerate, then re-stage."
  exit 1
fi

echo "  ✅ All docs-governance checks passed."
exit 0
