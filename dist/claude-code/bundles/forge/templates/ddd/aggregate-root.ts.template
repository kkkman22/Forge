/**
 * {{AggregateName}} Aggregate Root
 * {{Description}}
 */

import { {{EventNames}} } from "./events.js";

{{#if Invariants}}
// Invariants
{{#each Invariants}}
// - {{this}}
{{/each}}
{{/if}}

export class {{AggregateName}} {
  private constructor(
    {{#each Fields}}
    private readonly _{{this.name}}: {{this.type}},
    {{/each}}
    private _version: number = 0,
  ) {}

  static {{FactoryMethodName}}(
    {{#each FactoryParams}}
    {{this.name}}: {{this.type}},
    {{/each}}
  ): {{AggregateName}} {
    {{#each InvariantChecks}}
    if (!{{this.condition}}) {
      throw new Error("{{this.message}}");
    }
    {{/each}}

    const instance = new {{AggregateName}}(
      {{#each FactoryArgs}}
      {{this}},
      {{/each}}
    );

    {{#if HasEvents}}
    // Domain event would be published here
    // instance.addDomainEvent(new {{FirstEventName}}(...));
    {{/if}}

    return instance;
  }

  {{#each StateTransitions}}
  {{this.methodName}}({{this.params}}): void {
    // Pre-condition: {{this.preCondition}}
    if (!{{this.guard}}) {
      throw new Error("{{this.errorMessage}}");
    }
    // Apply state transition
    // Publish domain event if needed
    this._version++;
  }

  {{/each}}

  {{#if Serialization}}
  toJSON(): Record<string, unknown> {
    return {
      {{#each Fields}}
      {{this.name}}: this._{{this.name}},
      {{/each}}
      version: this._version,
    };
  }
  {{/if}}

  get version(): number {
    return this._version;
  }
}
