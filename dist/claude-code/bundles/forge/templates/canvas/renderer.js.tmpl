// Derived from Cursor pr-review-canvas renderer — see references/canvas.md
(function() {
  var data;
  try {
    var el = document.getElementById('findings-data');
    data = JSON.parse(el.textContent);
  } catch(e) {
    document.body.innerHTML = '<p style="color:#ef4444">Error loading findings data</p>';
    return;
  }

  var layers = ['spec', 'quality', 'security'];
  var layerNames = { spec: 'Spec', quality: 'Quality', security: 'Security' };

  layers.forEach(function(layer) {
    var container = document.getElementById(layer + '-findings');
    var findings = (data[layer] || []);
    if (findings.length === 0) {
      container.innerHTML = '<div class="no-findings">No findings</div>';
      return;
    }
    findings.forEach(function(f) {
      var div = document.createElement('div');
      div.className = 'finding ' + (f.severity || 'p3').toLowerCase();
      div.innerHTML = '<div class="issue"></div><div class="meta">' +
        (f.file || '') + ' | ' + (f.severity || '') +
        '</div>';
      // Safe: set textContent for issue to prevent XSS
      div.querySelector('.issue').textContent = f.issue || '';
      var suggestion = f.suggestion ? '<div class="suggestion">' + f.suggestion + '</div>' : '';
      if (suggestion) {
        var sDiv = document.createElement('div');
        sDiv.className = 'suggestion';
        sDiv.textContent = f.suggestion;
        div.appendChild(sDiv);
      }
      container.appendChild(div);
    });
  });

  document.getElementById('timestamp').textContent = data.generatedAt || new Date().toISOString();
  if (data.footerNotice) {
    document.getElementById('footer-notice').textContent = data.footerNotice;
  }
})();
